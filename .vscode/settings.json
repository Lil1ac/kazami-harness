    "**/__pycache__": true,
    "**/*.egg-info": true,
    "**/node_modules": true,
    "**/dist": true,
    ".venv": true,
    ".uv-cache": true,
    ".pytest_cache": true,
    ".ruff_cache": true,
    ".mypy_cache": true,
    ".playwright-cli": true,
    ".runtime": true,
    ".runs": true,
    "output": true
  }
}